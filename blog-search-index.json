---
layout: null
permalink: /assets/search/blog-index.json
---
[
  {% assign published_posts = site.posts | where: "published_status", 1 %}
  {% for post in published_posts %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "date": {{ post.date | date_to_xmlschema | jsonify }},
      "date_text": {{ post.date | date: "%B %-d, %Y" | jsonify }},
      "excerpt": {{ post.excerpt | strip_html | normalize_whitespace | jsonify }},
      "content": {{ post.content | strip_html | normalize_whitespace | jsonify }},
      "tags": {{ post.tags | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
